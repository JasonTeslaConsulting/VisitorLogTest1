    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.75.0",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.11.0",
    "react-router": "8.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
