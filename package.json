{
  "name": "visitor-log",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "framework": {
    "$comment": "role is declared HERE, not in platform/framework.json, because framework.json is inside the git-subtree prefix and would be overwritten by `npm run framework:update` — silently flipping a portal back to \"source\" and disabling Gate B. package.json is app-owned and never synced. \"source\" = this is the framework's own repo/template (platform/** is editable, hash checks off). \"consumer\" = a portal (platform/** read-only, hash-checked against platform/framework.lock).",
    "role": "consumer"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node platform/scripts/docs-check.mjs",
    "app:init": "node platform/scripts/app-init.mjs",
    "framework:verify": "node platform/scripts/framework-verify.mjs",
    "framework:lock": "node platform/scripts/framework-lock.mjs",
    "framework:apply": "node platform/scripts/framework-apply.mjs",
    "framework:link": "node platform/scripts/framework-link.mjs",
    "framework:reset": "node platform/scripts/framework-reset.mjs",
    "framework:publish": "node platform/scripts/framework-publish.mjs",
    "framework:update": "node platform/scripts/framework-update.mjs",
    "docs:arch": "node platform/scripts/gen-arch-docs.mjs",
    "docs:plan": "node platform/scripts/gen-plan-docs.mjs",
    "plan:next": "node platform/scripts/gen-plan-docs.mjs --next",
    "gen-supabase-types": "node platform/scripts/gen-supabase-types.mjs --project-id hauccbcyondtbmzscuiw"
  },
