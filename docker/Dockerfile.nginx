# Self-contained build — no private registry required. Serves the built SPA from
# nginx using docker/nginx.conf, which falls back to index.html so client-side
# routes survive a page reload.
#
#   docker build -f docker/Dockerfile.nginx -t <portal-name>:latest .
#   docker run --rm -p 8080:80 <portal-name>:latest
FROM node:24-alpine AS build
WORKDIR /src
COPY ["package.json", "package-lock.json", "./"]
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
